{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/skuvo",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "server/server.mjs": {
      "includeFiles": "browser/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/server.mjs"
    }
  ]
}
